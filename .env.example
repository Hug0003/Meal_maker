# Copier en .env puis adapter. Aucun secret ne doit être commité.
POSTGRES_USER=meal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meal_maker
# Mot de passe unique pour protéger le site (laisser vide = accès libre)
APP_PASSWORD=
# Clé de signature du cookie de session (32+ caractères aléatoires)
COOKIE_SECRET=change-me-with-a-long-random-string-please
# Importer les recettes TheMealDB au démarrage de l'API (nécessite Internet)
IMPORT_MEALDB=false
# Port public du site
WEB_PORT=8080
